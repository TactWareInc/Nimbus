import kotlin.Boolean;
import kotlin.Long;



storeProject:
INSERT OR REPLACE INTO Projects(id, name, projectUrl, isAzureDevopsServer, personalAccessToken, projectProcessType, patExpirationDate) VALUES (?,?, ?, ?, ?, ?, ?);

getAllProjects:
SELECT * FROM Projects;

getProjectByName:
SELECT * FROM Projects WHERE name = ?;

getProjectById:
SELECT * FROM Projects WHERE id = ?;

deleteProject:
DELETE FROM Projects WHERE id = ?;

updatePat:
UPDATE Projects SET personalAccessToken = ? WHERE name = ?;

updatePatExpiration:
UPDATE Projects SET patExpirationDate = ? WHERE name = ?;

checkIfProjectExistsByURL:
SELECT EXISTS(SELECT 1 FROM Projects WHERE projectUrl = ?) AS result;

getAllProjectNames:
SELECT name, id FROM Projects;
